{
  "name": "parentpath",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "ng lint --max-warnings 0",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage",
    "test:functions": "deno test --allow-env --allow-net supabase/functions",
    "test:rls": "playwright test --project=rls",
    "e2e": "playwright test --project=chromium --project=mobile",
    "types:db": "supabase gen types typescript --linked > src/app/core/supabase/database.types.ts",
    "screens:coverage": "node tools/screen-coverage.mjs",
    "screens:coverage:strict": "node tools/screen-coverage.mjs --strict",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run screens:coverage:strict && npm run build",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.4",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngrx/signals": "^22.0.1",
    "@supabase/supabase-js": "^2.118.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/pwa": "^22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.0"
  }
}
